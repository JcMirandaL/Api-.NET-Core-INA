@using InaApp.ProyectoInaApp.Models.Factura

@model FacturaCreateViewModel

@{
    ViewData["Title"] = "Crear Factura";
}

<h2>Crear Factura</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken() <!--envio tokken para que el controller lo valide-->

    <!-- Muestra errores de ModelState (ej: stock insuficiente, descuento inválido) -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Datos de la Factura
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label asp-for="ClienteId" class="form-label"></label>
                <!--Guarda el id para enviarlo--> 
                <input type="hidden" asp-for="ClienteId" id="ClienteId" />
                <!--hidden para que el nombre del cliente sobreviva los POSTs-->
                <input type="hidden" asp-for="ClienteNombre" id="ClienteNombre" />
                <div class="input-group">
                    <input type="text" id="ClienteNombreDisplay"
                           class="form-control" readonly
                           placeholder="Seleccione un cliente..."
                           value="@Model.ClienteNombre" />
                           <!--Value para jalar el nombre al crear la factura-->
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="abrirModalCliente()" title="Buscar">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                <span asp-validation-for="ClienteId"
                      class="text-danger"></span>
            </div>
        </div>
    </div>

    <!----------------AGREGAR PRODUCTO--------------->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            Agregar Producto
        </div>

        <div class="card-body">

            <!-- Fila 1: Buscar producto -->
            <div class="row mb-3">
                <div class="col-md-12">
                    <label asp-for="ProductoId" class="form-label"></label>
                    <input type="hidden" asp-for="ProductoId" id="ProductoId" />
                    <input type="hidden" asp-for="ProductoNombre" id="ProductoNombre" />
                    <div class="input-group">
                        <input type="text" id="ProductoNombreDisplay"
                               class="form-control" readonly
                               placeholder="Seleccione un producto..."
                               value="@Model.ProductoNombre" />
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="abrirModalProducto()">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ProductoId"
                          class="text-danger"></span>
                </div>
            </div>

            <!-- Fila 2: Cantidad + Descuento + Botón Agregar -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Cantidad"
                           class="form-label"></label>
                    <input asp-for="Cantidad" class="form-control"
                           id="CantidadInput" />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DescuentoAplicado"
                           class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="DescuentoAplicado" class="form-control"
                               id="DescuentoInput" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="DescuentoAplicado" class="text-danger"></span>
                    <small id="descuentoMaximoInfo" class="text-muted"></small>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit"
                            asp-action="AddProduct"
                            class="btn btn-success w-100">
                        Agregar Producto
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!--------------- DETALLE -------------->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            Detalle de la Factura
        </div>

        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio U.</th>
                        <th>Cant.</th>
                        <th>Subtotal</th>
                        <th>%Desc.</th>
                        <th>Monto Desc.</th>
                        <th>%Imp.</th>
                        <th>Monto Imp.</th>
                        <th>Total Línea</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Detalles.Count; i++)
                    {
                        var item = Model.Detalles[i];

                        <!-- Hidden fields para que los detalles viajen en el form -->
                        <input type="hidden" name="Detalles[@i].ProductoId" value="@item.ProductoId" />
                        <input type="hidden" name="Detalles[@i].ProductoNombre" value="@item.ProductoNombre" />
                        <input type="hidden" name="Detalles[@i].Precio" value="@item.Precio" />
                        <input type="hidden" name="Detalles[@i].Cantidad" value="@item.Cantidad" />
                        <input type="hidden" name="Detalles[@i].Subtotal" value="@item.Subtotal" />
                        <input type="hidden" name="Detalles[@i].DescuentoAplicado" value="@item.DescuentoAplicado" />
                        <input type="hidden" name="Detalles[@i].DescuentoMonto" value="@item.DescuentoMonto" />
                        <input type="hidden" name="Detalles[@i].PorcentajeImpuesto" value="@item.PorcentajeImpuesto" />
                        <input type="hidden" name="Detalles[@i].MontoImpuesto" value="@item.MontoImpuesto" />
                        <input type="hidden" name="Detalles[@i].TotalLinea" value="@item.TotalLinea" />

                        <tr>
                            <td>@item.ProductoNombre</td>
                            <td>₡@item.Precio.ToString("N2")</td>
                            <td>@item.Cantidad</td>
                            <td>₡@item.Subtotal.ToString("N2")</td>
                            <td>@item.DescuentoAplicado%</td>
                            <td>₡@item.DescuentoMonto.ToString("N2")</td>
                            <td>@item.PorcentajeImpuesto.ToString("N1")%</td>
                            <td>₡@item.MontoImpuesto.ToString("N2")</td>
                            <td><strong>₡@item.TotalLinea.ToString("N2")</strong></td>
                            <td>
                                <button type="submit"
                                        asp-action="RemoveProduct"
                                        asp-route-productoId="@item.ProductoId"
                                        formnovalidate
                                        class="btn btn-danger btn-sm">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }

                    @if (Model.Detalles.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">
                                No hay productos agregados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!----------- TOTALES----------->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            Resumen
        </div>
        <div class="card-body">

            <div class="text-end">
                <h5>
                    Subtotal General:
                    ₡@Model.Subtotal.ToString("N2")
                </h5>

                <h5>
                    Total Impuestos:
                    ₡@Model.TotalImpuestos.ToString("N2")
                </h5>

                <h5>
                    Descuento Total:
                    −₡@Model.DescuentoTotal.ToString("N2")
                </h5>

                <hr />

                <h4>
                    <strong>Total Final: ₡@Model.Total.ToString("N2")</strong>
                </h4>
            </div>
        </div>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar Factura
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>


<!-- Modal Cliente -->
<div class="modal fade" id="modalCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="buscarClienteInput" class="form-control"
                           placeholder="Buscar por nombre, apellido o cédula..."
                           onkeyup="buscarClientes()" />
                </div>
                <div id="resultadoClientes">
                    <p class="text-muted text-center my-3">Cargando...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Producto -->
<div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="buscarProductoInput" class="form-control"
                           placeholder="Buscar por nombre..."
                           onkeyup="buscarProductos()" />
                </div>
                <div id="resultadoProductos">
                    <p class="text-muted text-center my-3">Cargando...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>


<!--le digo al razor que esto es una seccion de scrips, solo ejecutable en esta vista-->
@section Scripts {
    <!--El partialName es para las validaciopnes del lado del cliente-->
    <partial name="_ValidationScriptsPartial" />
    <!--inyecto el archivo de js-->
    <script src="~/js/modalesViewCreateFactura.js"></script>
}