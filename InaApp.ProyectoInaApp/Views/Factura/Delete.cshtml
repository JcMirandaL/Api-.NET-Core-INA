@using InaApp.ProyectoInaApp.Models.Factura



<!--REUTILIZO EL VM de index q es solo para mostrar datos-->
@model FacturaIndexViewModel
@{
    ViewData["Title"] = "Eliminar Cliente";
}

@Html.AntiForgeryToken() <!--envio tokken para que el controller lo valide-->

<div class="container mt-4">

    <h2>Anular Factura</h2>

    <div class="alert alert-warning mt-3">
        <strong>Advertencia:</strong>
        ¿Está seguro que desea anular la siguiente Factura?
    </div>

    <div class="card">
        <div class="card-header bg-danger text-white">
            Confirmación de anulación
        </div>

        <div class="card-body">
            <p><strong>Id:</strong> @Model.Id</p>
            <p><strong>ClienteNombre:</strong> @Model.ClienteNombre</p>
            <p><strong>Fecha:</strong> @Model.Fecha</p>
            <p><strong>Subtotal:</strong> ₡@Model.Subtotal</p>
            <p><strong>Descuento:</strong> ₡@Model.DescuentoTotal</p>
            <p><strong>Descuento:</strong> ₡@Model.TotalImpuestos</p>
            <p><strong>Total:</strong> ₡@Model.Total</p>
            <p><strong>Estado:</strong> @(Model.Estado ? "☑ Registrada" : "❌ Factura Anulada")</p>
        </div>
    </div>

    <!--metodo post para pasar el id y eliminar-->
    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Sí, Anular
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>

</div>
