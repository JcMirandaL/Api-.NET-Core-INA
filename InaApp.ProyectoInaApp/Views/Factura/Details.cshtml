@using InaApp.ProyectoInaApp.Models.Factura
@using static InaApp.Common.Enums.Enumeradores

@model FacturaDetailsViewModel

@{
    ViewData["Title"] = "Detalle de Factura";
}

<div class="container mt-4">

    <h2>Detalle de Factura</h2>

    <!-- ENCABEZADO -->
    <div class="card mt-3">
        <div class="card-header bg-primary text-white">
            Información General
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-3">
                    <strong>Factura:</strong><br />
                    @Model.Id
                </div>

                <div class="col-md-4">
                    <strong>Cliente:</strong><br />
                    @Model.ClienteNombre
                </div>

                <div class="col-md-3">
                    <strong>Fecha:</strong><br />
                    @Model.Fecha.ToString("dd/MM/yyyy")
                </div>

                <div class="col-md-2">
                    <strong>Tipo Documento:</strong><br />
                    @Html.DisplayFor(m => m.TipoDocumento)
                </div>

                @if (Model.TipoDocumento == TipoDocumentoEnum.NotaCredito && Model.FacturaReferenciaId.HasValue)
                {
                    <div class="col-md-3">
                        <strong>Factura de Referencia:</strong><br />
                        <a asp-action="Details" asp-route-id="@Model.FacturaReferenciaId.Value">
                            #@Model.FacturaReferenciaId.Value
                        </a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MotivoNotaCredito))
                {
                    <div class="row mt-2">
                        <div class="col-md-12">
                            <strong>Motivo Nota de Crédito:</strong><br />
                            @Model.MotivoNotaCredito
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- DETALLE -->
    <div class="card mt-4">
        <div class="card-header bg-secondary text-white">
            Productos Facturados
        </div>

        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">

                    <tr>
                        <th>Producto</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-end">Precio U.</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-center">%Desc.</th>
                        <th class="text-end">Monto Desc.</th>
                        <th class="text-center">%Imp.</th>
                        <th class="text-end">Monto Imp.</th>
                        <th class="text-end">Total Línea</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Detalles)
                    {
                        <tr>
                            <td>@item.ProductoNombre</td>
                            <td class="text-center">@item.Cantidad</td>
                            <td class="text-end">₡@item.Precio.ToString("N2")</td>
                            <td class="text-end">₡@item.Subtotal.ToString("N2")</td>
                            <td class="text-center">@item.DescuentoAplicado%</td>
                            <td class="text-end">₡@item.DescuentoMonto.ToString("N2")</td>
                            <td class="text-center">@item.PorcentajeImpuesto.ToString("N1")%</td>
                            <td class="text-end">₡@item.MontoImpuesto.ToString("N2")</td>
                            <td class="text-end"><strong>₡@item.TotalLinea.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TOTALES -->
    <div class="card mt-4">

        <div class="card-header bg-success text-white">
            Resumen
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 offset-md-8">

                    <table class="table table-borderless">

                        <tr>
                            <th>Subtotal:</th>
                            <td class="text-end">₡@Model.Subtotal.ToString("N2")</td>
                        </tr>

                        <tr>
                            <th>Total Impuestos:</th>
                            <td class="text-end">₡@Model.TotalImpuestos.ToString("N2")</td>
                        </tr>

                        <tr>
                            <th>Descuento Total:</th>
                            <td class="text-end">−₡@Model.DescuentoTotal.ToString("N2")</td>
                        </tr>

                        <tr class="table-success">
                            <th>Total:</th>
                            <th class="text-end">₡@Model.Total.ToString("N2")</th>
                        </tr>

                    </table>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-4">
        Volver al listado
    </a>

</div>