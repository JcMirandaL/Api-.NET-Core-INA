@using InaApp.ProyectoInaApp.Models.Factura


<!--el import no hace falta xq ya esta en el archivo _ViewImports.cshtml
    Esto para usar el modelo de vista ProductoIndexViewModel que es el que se va a usar en la vista-->
@model List<FacturaIndexViewModel>

@{
    ViewData["Title"] = "Facturas";
}

<!--Tabla de bootstrap-->
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Facturas</h2>

        <!--El asp-action es para decirle a que vista ir en este caso CREATE-->
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nueva Factura
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre Cliente</th>
                <th>Fecha</th>
                <th>Subtotal</th>
                <th>Total Desc.</th>
                <th>Total Imp.</th>
                <th>Total</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var factura in Model)
                {
                    <tr>
                        <td>@factura.Id</td>
                        <td>@factura.ClienteNombre</td>
                        <td>@factura.Fecha</td>
                        <td>₡@factura.Subtotal.ToString("N2")</td>
                        <td>₡@factura.DescuentoTotal</td>
                        <td>₡@factura.TotalImpuestos</td>
                        <td>₡@factura.Total.ToString("N2")</td>
                        <td>@(factura.Estado ? "☑ Registrada" : "❌ Factura Anulada")</td>
                        <td class="text-center">
                            <a asp-action="Details"
                               asp-route-id="@factura.Id"
                               class="btn btn-info btn-sm my-1">
                                Detalles
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@factura.Id"
                               class="btn btn-danger btn-sm my-1">
                                Anular Factura
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">
                        No existen facturas registradas.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>