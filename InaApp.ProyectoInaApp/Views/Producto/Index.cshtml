@using InaApp.ProyectoInaApp.Models.Producto


<!--el import no hace falta xq ya esta en el archivo _ViewImports.cshtml
    Esto para usar el modelo de vista ProductoIndexViewModel que es el que se va a usar en la vista-->
@model List<ProductoIndexViewModel>

@{
    ViewData["Title"] = "Productos";
}

<!--Tabla de bootstrap-->
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Productos</h2>

        <!--El asp-action es para decirle a que vista ir en este caso CREATE-->
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nuevo Producto
        </a>
    </div>
    
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Categoria</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Impuesto Aplicable</th>
                <th>Porcentaje Impuesto</th>
                <th>Descuento Maximo</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
    
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.Id</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.CategoriaNombre</td>
                        <td>₡@producto.Precio.ToString("N2")</td>
                        <td>@producto.Stock</td>
                        <td>@Html.DisplayFor(m => producto.ImpuestoAplicable)</td>
                        <td>@producto.PorcentajeImpuesto.ToString("N1")%</td>
                        <td>@producto.DescuentoMaximo%</td>
                        <td class="text-center">
                            <a asp-action="Details"
                               asp-route-id="@producto.Id"
                               class="btn btn-info btn-sm my-1">
                                Detalles
                            </a>

                            <!--Este es el metodo Edit del controllador y cargue la vista-->
                            <!--con el asp-route-id le paso el parametro-->
                            <a asp-action="Edit"
                               asp-route-id="@producto.Id"
                               class="btn btn-warning btn-sm my-1">
                                Modificar
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@producto.Id"
                               class="btn btn-danger btn-sm my-1">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">
                        No existen productos registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>