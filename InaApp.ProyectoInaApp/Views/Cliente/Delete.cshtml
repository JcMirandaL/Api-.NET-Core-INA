@using InaApp.ProyectoInaApp.Models.Cliente



<!--REUTILIZO EL VM de index q es solo para mostrar datos-->
@model ClienteIndexViewModel
@{
    ViewData["Title"] = "Eliminar Cliente";
}


<div class="container mt-4">

    <h2>Eliminar Cliente</h2>

    <div class="alert alert-warning mt-3">
        <strong>Advertencia:</strong>
        ¿Está seguro que desea eliminar el siguiente Cliente?
    </div>

    <div class="card">
        <div class="card-header bg-danger text-white">
            Confirmación de eliminación
        </div>

        <div class="card-body">
            <p><strong>Id:</strong> @Model.Id</p>
            <p><strong>Cedula:</strong> @Model.Cedula</p>
            <p><strong>Tipo Cedula:</strong> @Model.TipoCedula</p>
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Apellido 1:</strong> @Model.Apellido1</p>
            <p><strong>Apellido 2:</strong> ₡@Model.Apellido2</p>
            <p><strong>Correo:</strong> @Model.Correo</p>
            <p><strong>Telefono:</strong> @Model.Telefono</p>
            <p><strong>Fecha de Nacimiento:</strong> @Model.FechaNacimiento</p>
        </div>
    </div>

    <!--metodo post para pasar el id y eliminar-->
    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Sí, eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>

</div>
