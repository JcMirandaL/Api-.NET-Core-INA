@using InaApp.ProyectoInaApp.Models.Categoria



<!--Esto para usar el modelo de vista CategoriaIndexViewModel que es el que se va a usar en la vista-->
@model List<CategoriaIndexViewModel>

@{
    //titulo q aparece en la pestaña del navegador
    ViewData["Title"] = "Categorias";
}

<!--Tabla de bootstrap-->
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Categorias</h2>

        <!--El asp-action es para decirle a que vista ir en este caso CREATE-->
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nueva Categoria
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            <!--Para validar si hay modelo-->
            @if (Model != null && Model.Any())
            {
                <!--Itero la lista para traer los datos-->
                foreach (var categoria in Model)
                {
                    <tr>
                        <td>@categoria.Id</td>
                        <td>@categoria.Nombre</td>
                        
                        <td class="text-center">
                            <a asp-action="Details"
                               asp-route-id="@categoria.Id"
                               class="btn btn-info btn-sm">
                                Detalles
                            </a>

                            <!--Este es el metodo Edit del controllador y cargue la vista-->
                            <!--con el asp-route-id le paso el parametro-->
                            <a asp-action="Edit"
                               asp-route-id="@categoria.Id"
                               class="btn btn-warning btn-sm">
                                Modificar
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@categoria.Id"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No existen categorias registradas.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>