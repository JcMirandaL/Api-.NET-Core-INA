
@using InaApp.ProyectoInaApp.Models.Factura
@using static InaApp.Common.Enums.Enumeradores

@model FacturaCreateViewModel

@{
    ViewData["Title"] = "Crear Nota De Credito";
}

<div class="container mt-4">
    <h2>Crear Nota De Credito</h2>

    <form asp-action="CreditNoteCreate" method="post">
        @Html.AntiForgeryToken() <!--envio tokken para que el controller lo valide-->

        <!-- Cliente (readOnly) -->
        <div class="card mt-3">
            <div class="card-header bg-warning text-dark">
                Cliente
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">Cliente</label>
                        <input asp-for="@Model.ClienteNombre" class="form-control" readonly />
                        <input type="hidden" asp-for="@Model.ClienteId" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Factura de Referencia</label>
                        <input class="form-control" value="#@Model.FacturaReferenciaId" readonly />
                        <input type="hidden" asp-for="@Model.FacturaReferenciaId" />
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-md-12">
                        <label asp-for="@Model.MotivoNotaCredito" class="form-label">Motivo de la Nota de Crédito</label>
                        <textarea asp-for="@Model.MotivoNotaCredito" class="form-control" rows="3" required></textarea>
                        <span asp-validation-for="@Model.MotivoNotaCredito" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Productos -->
        <div class="card mt-3">
            <div class="card-header bg-warning text-dark">
                Productos a Devolver
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Cant. Original</th>
                            <th class="text-center">Cant. a Devolver</th>
                            <th class="text-end">Precio U.</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-center">%Desc.</th>
                            <th class="text-end">Monto Desc.</th>
                            <th class="text-center">%Imp.</th>
                            <th class="text-end">Monto Imp.</th>
                            <th class="text-end">Total Línea</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            var item = Model.Detalles[i];

                            <tr>
                                <td>
                                    @item.ProductoNombre
                                    <input type="hidden" asp-for="@Model.Detalles[i].ProductoId" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].ProductoNombre" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].Precio" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].CantidadOriginal" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].Subtotal" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].DescuentoAplicado" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].DescuentoMonto" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].PorcentajeImpuesto" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].MontoImpuesto" />
                                    <input type="hidden" asp-for="@Model.Detalles[i].TotalLinea" />
                                </td>
                                <td class="text-center">@item.CantidadOriginal</td>
                                <td class="text-center">
                                    <input asp-for="@Model.Detalles[i].Cantidad"
                                           class="form-control text-center"
                                           type="number"
                                           min="0"
                                           max="@item.CantidadOriginal"
                                           style="width:100px; display:inline;" />
                                    <span asp-validation-for="@Model.Detalles[i].Cantidad" class="text-danger"></span>
                                </td>
                                <td class="text-end">₡@item.Precio.ToString("N2")</td>
                                <td class="text-end">₡@item.Subtotal.ToString("N2")</td>
                                <td class="text-center">@item.DescuentoAplicado%</td>
                                <td class="text-end">₡@item.DescuentoMonto.ToString("N2")</td>
                                <td class="text-center">@item.PorcentajeImpuesto.ToString("N1")%</td>
                                <td class="text-end">₡@item.MontoImpuesto.ToString("N2")</td>
                                <td class="text-end"><strong>₡@item.TotalLinea.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TOTALES -->
        <div class="card mt-3">
            <div class="card-header bg-success text-white">
                Resumen de la Factura Original
            </div>
            <div class="card-body">
                <div class="text-end">
                    <h5>
                        Subtotal General:
                        ₡@Model.Subtotal.ToString("N2")
                    </h5>

                    <h5>
                        Total Impuestos:
                        ₡@Model.TotalImpuestos.ToString("N2")
                    </h5>

                    <h5>
                        Descuento Total:
                        −₡@Model.DescuentoTotal.ToString("N2")
                    </h5>

                    <hr />

                    <h4>
                        <strong>Total Final: ₡@Model.Total.ToString("N2")</strong>
                    </h4>
                </div>
            </div>
        </div>

        <input type="hidden" asp-for="@Model.Subtotal" />
        <input type="hidden" asp-for="@Model.TotalImpuestos" />
        <input type="hidden" asp-for="@Model.DescuentoTotal" />
        <input type="hidden" asp-for="@Model.Total" />

        <!-- Botón submit -->
        <div class="mt-3">
            <button type="submit" class="btn btn-warning">Emitir Nota Crédito</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>